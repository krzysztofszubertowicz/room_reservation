# Skopiuj ten plik do ".env" (w tym samym folderze) i uzupelnij wartosci:
#   cp .env.example .env
#
# Plik .env jest ignorowany przez git (sekrety nie trafia do repozytorium).

# --- Baza danych (SQL Server) ---
# DB_SERVER ustawiany jest automatycznie w docker-compose na nazwe uslugi "db".
DB_SERVER=db
DB_NAME=room_reservation
DB_USER=sa
# UWAGA: SQL Server wymaga "silnego" hasla:
# min. 8 znakow, wielka litera, mala litera, cyfra i znak specjalny.
DB_PASSWORD=Your_Strong_Passw0rd!

# --- JWT (logowanie / tokeny) ---
SECRET_KEY=zmien-na-dlugi-losowy-ciag-znakow
ALGORITHM=HS256

# --- SMTP (powiadomienia e-mail; opcjonalne) ---
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=twoj@email.com
SMTP_PASSWORD=haslo-do-smtp
